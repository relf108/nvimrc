@@ -0,0 +1,143 @@
+local uv = vim.uv or vim.loop
+local Queue = require("fzf-lua.lib.queue")
+
+---@class fzf-lua.StreamJob
+---@field data string|string[]
+---@field callback fun(err?: any)
+---@field index integer
+---@field done? boolean
+
+---@class fzf-lua.StreamOptions
+---@field eol string
+---@field transform? fun(line: string): string?
+---@field write fun(data: string, callback: fun(err?: any))
+---@field on_error? fun(err: any)
+---@field budget_ms? number
+
+---@class fzf-lua.lib.stream
+---@field opts fzf-lua.StreamOptions
+---@field queue fzf-lua.lib.queue
+---@field current? fzf-lua.StreamJob
+---@field timer? uv.uv_timer_t
+---@field writing? boolean
+---@field budget number
+---@field stopped boolean
+local M = {}
+M.__index = M
+
+-- One writer belongs to one producer connection. Cancellation invalidates all
+-- deferred work on that connection; a reload creates a separate writer.
+---@param opts fzf-lua.StreamOptions
+---@return fzf-lua.lib.stream
+function M.new(opts)
+  return setmetatable({
+    opts = opts,
+    queue = Queue.new(),
+    budget = (opts.budget_ms or 4) * 1e6,
+    stopped = false,
+  }, M)
+end
+
+---@param job? fzf-lua.StreamJob
+---@param err? any
+local function complete(job, err)
+  if job and not job.done then
+    job.done = true
+    job.callback(err)
+  end
+end
+
+---@param err? any
+function M:cancel(err)
+  if self.stopped then return end
+  self.stopped = true
+  if self.timer and not self.timer:is_closing() then
+    self.timer:stop()
+    self.timer:close()
+  end
+  self.timer = nil
+  local current = self.current
+  self.current = nil
+  complete(current, err or "ECANCELED")
+  while not self.queue:empty() do
+    complete(self.queue:pop(), err or "ECANCELED")
+  end
+end
+
+function M:schedule()
+  if self.stopped or self.timer then return end
+  -- A zero-delay timer yields to input, timers and pipe callbacks, rather than
+  -- continually appending work to the same scheduled-event drain.
+  self.timer = vim.defer_fn(function()
+    self.timer = nil
+    self:step()
+  end, 0)
+end
+
+function M:step()
+  if self.stopped or self.writing then return end
+  self.current = self.current or self.queue:pop()
+  local job = self.current
+  if not job then return end
+
+  local ok, data = pcall(function()
+    if type(job.data) ~= "table" then
+      job.index = 2
+      return tostring(job.data)
+    end
+    if #job.data == 0 then return "" end
+    local output = {}
+    local started = uv.hrtime()
+    repeat
+      local value = job.data[job.index]
+      if self.opts.transform then value = self.opts.transform(value) end
+      if value then output[#output + 1] = value end
+      job.index = job.index + 1
+    until job.index > #job.data or uv.hrtime() - started >= self.budget
+    return #output > 0 and table.concat(output, self.opts.eol) .. self.opts.eol or ""
+  end)
+  if not ok then
+    self:cancel(data)
+    if self.opts.on_error then self.opts.on_error(data) end
+    return
+  end
+
+  local function written(err)
+    self.writing = false
+    if self.stopped then return end
+    if err then
+      self:cancel(err)
+      return
+    end
+    local size = type(job.data) == "table" and #job.data or 1
+    if job.index > size then
+      self.current = nil
+      complete(job)
+      if not self.stopped and not self.queue:empty() then self:schedule() end
+    else
+      self:schedule()
+    end
+  end
+  self.writing = true
+  if data == "" then
+    written()
+  else
+    local success, err = pcall(self.opts.write, data, written)
+    if not success then self:cancel(err) end
+  end
+end
+
+---@param data string|string[]
+---@param callback fun(err?: any)
+function M:write(data, callback)
+  if self.stopped then
+    callback("ECANCELED")
+    return
+  end
+  self.queue:push({ data = data, index = 1, callback = callback })
+  if not self.current and not self.timer and not self.writing then
+    if vim.in_fast_event() then self:schedule() else self:step() end
+  end
+end
+
+return M
