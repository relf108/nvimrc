diff --git a/tests/stream_spec.lua b/tests/stream_spec.lua
new file mode 100644
index 0000000..6191c3b
--- /dev/null
+++ b/tests/stream_spec.lua
@@ -0,0 +1,264 @@
+local helpers = require("fzf-lua.test.helpers")
+local assert = helpers.assert
+local MiniTest = require("mini.test")
+local Stream = require("fzf-lua.lib.stream")
+local libuv = require("fzf-lua.libuv")
+local uv = vim.uv or vim.loop
+
+local function wait(condition)
+  assert.is.True(vim.wait(6000, condition, 1))
+end
+
+local function producer(source)
+  local python = vim.fn.exepath("python3")
+  if python == "" then python = vim.fn.exepath("python") end
+  if python == "" then MiniTest.skip("Python is required for the stream producer") end
+  local file = vim.fn.tempname()
+  vim.fn.writefile(source, file)
+  return libuv.shellescape(python) .. " " .. libuv.shellescape(file), file
+end
+
+describe("Cooperative stream writer", function()
+  it("preserves ordering, filtering, empty batches and raw stderr", function()
+    local output, completed = {}, 0
+    local stream = Stream.new({
+      eol = "\n",
+      transform = function(line)
+        if line == "nil" then return nil end
+        return line ~= "false" and line:upper() or false
+      end,
+      write = function(data, callback)
+        output[#output + 1] = data
+        vim.schedule(function() callback() end)
+      end,
+    })
+    local function done(err)
+      assert.are.equal(nil, err)
+      completed = completed + 1
+    end
+    stream:write({ "a", "nil", "false", "b" }, done)
+    stream:write("raw stderr", done)
+    stream:write({}, done)
+    wait(function() return completed == 3 end)
+    assert.are.equal("A\nB\nraw stderr", table.concat(output))
+  end)
+
+  it("yields to timers between formatting batches", function()
+    local writes, turns, done = 0, 0, false
+    local stream = Stream.new({
+      eol = "\0", budget_ms = 1,
+      transform = function(line) uv.sleep(1); return line end,
+      write = function(_, callback) writes = writes + 1; callback() end,
+    })
+    local timer = _G.assert(uv.new_timer())
+    timer:start(0, 1, function() turns = turns + 1 end)
+    stream:write({ "1", "2", "3", "4", "5", "6" }, function() done = true end)
+    wait(function() return done end)
+    timer:stop()
+    timer:close()
+    assert.is.True(writes > 1 and turns > 1)
+  end)
+
+  it("cancels queued work and acknowledges each job exactly once", function()
+    local acknowledged, callbacks, transformed
+    callbacks, transformed = 0, 0
+    local stream = Stream.new({
+      eol = "\n",
+      transform = function(line) transformed = transformed + 1; return line end,
+      write = function(_, callback) acknowledged = callback end,
+    })
+    local function done(err) assert.is.True(not not err); callbacks = callbacks + 1 end
+    stream:write({ "one" }, done)
+    stream:write({ "two" }, done)
+    stream:cancel()
+    stream:cancel()
+    acknowledged("EPIPE")
+    vim.wait(10)
+    assert.are.equal(2, callbacks)
+    assert.are.equal(1, transformed)
+  end)
+
+  it("serializes fast-event and scheduled writes while a write is pending", function()
+    local callbacks, pending, output = 0, {}, {}
+    local stream = Stream.new({
+      eol = "\n",
+      write = function(data, callback)
+        output[#output + 1] = data
+        pending[#pending + 1] = callback
+      end,
+    })
+    local function done(err) assert.are.equal(nil, err); callbacks = callbacks + 1 end
+    local fast = vim.in_fast_event
+    vim.in_fast_event = function() return true end
+    stream:write({ "one" }, done)
+    vim.in_fast_event = fast
+    stream:write({ "two" }, done)
+    assert.are.equal(0, #output)
+    wait(function() return #output == 1 end)
+    vim.wait(10)
+    assert.are.equal(1, #output)
+    pending[1]()
+    wait(function() return #output == 2 end)
+    pending[2]()
+    assert.are.equal(2, callbacks)
+    assert.are.equal("one\ntwo\n", table.concat(output))
+  end)
+
+  it("reports formatter exceptions and stops the connection", function()
+    local failures, errors = 0, 0
+    local stream = Stream.new({
+      eol = "\n",
+      transform = function() error("bad formatter") end,
+      write = function() error("must not write") end,
+      on_error = function(err)
+        assert.is.True(tostring(err):find("bad formatter", 1, true) ~= nil)
+        errors = errors + 1
+      end,
+    })
+    stream:write({ "one" }, function(err) assert.is.True(not not err); failures = failures + 1 end)
+    assert.are.equal(1, errors)
+    assert.are.equal(1, failures)
+    assert.is.True(stream.stopped)
+  end)
+end)
+
+describe("Queued producer lifecycle", function()
+  it("preserves NUL-delimited input, embedded newlines and UTF-8", function()
+    local command, file = producer({
+      "import sys",
+      "sys.stdout.buffer.write('café\\0with\\nnewline\\0tail'.encode())",
+    })
+    local output, finishes = {}, 0
+    libuv.async_spawn({
+      cmd = command .. " --null", use_queue = true, EOL = "\0",
+      cb_write_lines = function(lines, callback)
+        vim.list_extend(output, lines)
+        vim.schedule(function() callback() end)
+      end,
+      cb_finish = function(code) assert.are.equal(0, code); finishes = finishes + 1 end,
+    }, true)
+    wait(function() return finishes > 0 end)
+    assert.are.same({ "café", "with\nnewline", "tail" }, output)
+    assert.are.equal(1, finishes)
+    os.remove(file)
+  end)
+
+  it("flushes partial lines and CRLF before completing once", function()
+    local command, file = producer({
+      "import sys,time",
+      "sys.stdout.write('part'); sys.stdout.flush(); time.sleep(.01)",
+      "sys.stdout.write('ial\\r\\nlast'); sys.stdout.flush()",
+    })
+    local output, finishes = {}, 0
+    libuv.async_spawn({
+      cmd = command, use_queue = true,
+      cb_write_lines = function(lines, callback)
+        vim.list_extend(output, lines)
+        vim.defer_fn(function() callback() end, 1)
+      end,
+      cb_finish = function(code) assert.are.equal(0, code); finishes = finishes + 1 end,
+    }, true)
+    wait(function() return finishes > 0 end)
+    vim.wait(10)
+    assert.are.same({ "partial", "last" }, output)
+    assert.are.equal(1, finishes)
+    os.remove(file)
+  end)
+
+  it("backpressures a slow consumer without treating a paused pipe as EOF", function()
+    local Queue = require("fzf-lua.lib.queue")
+    local new = Queue.new
+    local peak = 0
+    Queue.new = function()
+      local queue = new()
+      local bytes, push, pop = 0, queue.push, queue.pop
+      queue.push = function(self, data)
+        bytes = bytes + #data
+        peak = math.max(peak, bytes)
+        return push(self, data)
+      end
+      queue.pop = function(self)
+        local data = pop(self)
+        if data then bytes = bytes - #data end
+        return data
+      end
+      return queue
+    end
+    local marker = vim.fn.tempname()
+    local command, file = producer({
+      "import sys,pathlib",
+      "sys.stdout.buffer.write(b'x\\n' * 4194304); sys.stdout.flush()",
+      "pathlib.Path(" .. string.format("%q", marker) .. ").write_text('done')",
+    })
+    local blocked, acknowledged, lines, finishes, pid = true, nil, 0, 0, nil
+    local ok, err = pcall(function()
+      libuv.async_spawn({
+        cmd = command, use_queue = true,
+        cb_pid = function(value) pid = value end,
+        cb_write_lines = function(data, callback)
+          lines = lines + #data
+          if blocked then acknowledged = callback else vim.schedule(function() callback() end) end
+        end,
+        cb_finish = function(code) assert.are.equal(0, code); finishes = finishes + 1 end,
+      }, true)
+      wait(function() return acknowledged ~= nil end)
+      vim.wait(50)
+      assert.are.equal(0, finishes)
+      assert.are.equal(nil, uv.fs_stat(marker))
+      assert.is.True(peak <= 1024 * 1024 + 128 * 1024)
+      blocked = false
+      acknowledged()
+      wait(function() return finishes > 0 end)
+      assert.are.equal(4194304, lines)
+      assert.are.equal(1, finishes)
+    end)
+    Queue.new = new
+    if not ok then libuv.process_kill(pid) end
+    os.remove(file)
+    os.remove(marker)
+    if not ok then error(err) end
+  end)
+
+  it("cancels a paused producer without processing late acknowledgements", function()
+    if vim.fn.has("win32") == 1 then MiniTest.skip("POSIX exec is required for this producer") end
+    local command, file = producer({ "import time", "print('first',flush=True)", "time.sleep(60)" })
+    local pid, acknowledged, finishes, writes = nil, nil, 0, 0
+    libuv.async_spawn({
+      cmd = "exec " .. command, use_queue = true,
+      cb_pid = function(value) pid = value end,
+      cb_write_lines = function(_, callback) writes = writes + 1; acknowledged = callback end,
+      cb_finish = function() finishes = finishes + 1 end,
+    }, true)
+    wait(function() return acknowledged ~= nil end)
+    assert.is.True(libuv.process_kill(pid, "sigterm"))
+    wait(function() return finishes > 0 end)
+    acknowledged()
+    vim.wait(20)
+    assert.are.equal(1, finishes)
+    assert.are.equal(1, writes)
+    os.remove(file)
+  end)
+
+  it("handles a broken consumer pipe and reaps the producer", function()
+    local command, file = producer({
+      "import sys,time",
+      "while True:",
+      " sys.stdout.write('line\\n' * 1024); sys.stdout.flush(); time.sleep(.001)",
+    })
+    local pid, finishes, writes = nil, 0, 0
+    libuv.async_spawn({
+      cmd = command, use_queue = true,
+      cb_pid = function(value) pid = value end,
+      cb_write_lines = function(_, callback)
+        writes = writes + 1
+        vim.schedule(function() callback("EPIPE") end)
+      end,
+      cb_finish = function(code) assert.are.equal(130, code); finishes = finishes + 1 end,
+    }, true)
+    wait(function() return finishes > 0 end)
+    wait(function() return uv.os_getpriority(pid) == nil end)
+    assert.are.equal(1, finishes)
+    assert.are.equal(1, writes)
+    os.remove(file)
+  end)
+end)
